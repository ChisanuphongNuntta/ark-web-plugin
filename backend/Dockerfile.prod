# HeartShop Backend Production Dockerfile
# Multi-stage build for security and minimal image size

# Stage 1: Build
FROM node:22-bookworm-slim AS builder

WORKDIR /app

# Install OpenSSL for Prisma
RUN apt-get update && apt-get install -y openssl ca-certificates && rm -rf /var/lib/apt/lists/*

# Install dependencies
COPY package.json package-lock.json ./
RUN npm ci

# Copy prisma schema and generate client
COPY prisma ./prisma
RUN npx prisma generate

# Copy source code
COPY . .

# A production image must never be produced from a failed compile.
RUN npm run build

# Stage 2: Production
FROM node:22-bookworm-slim AS production

# Create non-root user for security
RUN groupadd -r heartshop && useradd -r -g heartshop heartshop

WORKDIR /app

# Install only runtime dependencies
RUN apt-get update && apt-get install -y \
    openssl \
    ca-certificates \
    curl \
    dumb-init \
    && rm -rf /var/lib/apt/lists/*

# Copy built application
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/prisma ./prisma
COPY --from=builder /app/scripts ./scripts
COPY --from=builder /app/dist ./dist
COPY --from=builder /app/package.json ./

# Create directories
RUN mkdir -p /app/logs /app/certs && \
    chown -R heartshop:heartshop /app

# Switch to non-root user
USER heartshop

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD curl -f http://localhost:3001/health || exit 1

# Environment
ENV NODE_ENV=production
ENV PORT=3001

EXPOSE 3001

# Use dumb-init for proper signal handling
ENTRYPOINT ["dumb-init", "--"]
# Apply versioned migrations before accepting traffic. Prisma serializes migration
# application, so parallel replicas cannot partially apply the same migration.
CMD ["sh", "-c", "npm run db:deploy && exec node dist/index.js"]
