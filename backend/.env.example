# Database
DATABASE_URL="postgresql://heartshop:heartshop_secret_2024@localhost:5432/heartshop"
REDIS_URL="redis://localhost:6379"

# Server
PORT=3001
NODE_ENV=development

# JWT Secret
JWT_SECRET=your-super-secret-jwt-key-change-this
JWT_EXPIRES_IN=7d

# Discord OAuth
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_CALLBACK_URL=http://localhost:3001/api/auth/discord/callback

# Steam OAuth
STEAM_API_KEY=
STEAM_REALM=http://localhost:3000
STEAM_RETURN_URL=http://localhost:3001/api/auth/steam/callback

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# Plugin Authentication
PLUGIN_MASTER_KEY=change-this-to-a-secure-key
