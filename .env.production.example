# ===========================================
# HeartShop Production Environment Configuration
# COPY TO .env AND FILL IN YOUR VALUES
# ===========================================

# ===========================================
# DATABASE
# ===========================================
POSTGRES_USER=heartshop
POSTGRES_PASSWORD=<GENERATE_STRONG_PASSWORD_32_CHARS>
POSTGRES_DB=heartshop
DATABASE_URL=postgresql://heartshop:<PASSWORD>@postgres-primary:5432/heartshop?sslmode=verify-full
REDIS_URL=rediss://redis-primary:6379
REDIS_PASSWORD=<GENERATE_STRONG_PASSWORD_32_CHARS>

# ===========================================
# SERVER
# ===========================================
PORT=3001
NODE_ENV=production
DOMAIN=your-domain.com

# ===========================================
# SECURITY - CRITICAL
# ===========================================
# Generate with: openssl rand -base64 64
JWT_SECRET=<GENERATE_64_BYTE_SECRET>
JWT_EXPIRES_IN=7d

# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=<GENERATE_32_BYTE_KEY>

# Generate with: openssl rand -base64 32
PLUGIN_MASTER_KEY=<GENERATE_32_BYTE_KEY>

# ===========================================
# DISCORD OAUTH
# Get from: https://discord.com/developers/applications
# ===========================================
DISCORD_CLIENT_ID=your_discord_client_id
DISCORD_CLIENT_SECRET=your_discord_client_secret
DISCORD_CALLBACK_URL=https://your-domain.com/api/auth/discord/callback

# ===========================================
# STEAM OAUTH
# Get from: https://steamcommunity.com/dev/apikey
# ===========================================
STEAM_API_KEY=your_steam_api_key
STEAM_REALM=https://your-domain.com
STEAM_RETURN_URL=https://your-domain.com/api/auth/steam/callback

# ===========================================
# FRONTEND
# ===========================================
FRONTEND_URL=https://your-domain.com
NEXT_PUBLIC_API_URL=https://your-domain.com/api

# ===========================================
# MONITORING & ALERTS
# ===========================================
# Slack webhook for security alerts (optional)
SLACK_WEBHOOK=https://hooks.slack.com/services/xxx/xxx/xxx

# ===========================================
# TLS/SSL
# ===========================================
# Certificate rotation interval (days)
CERT_ROTATION_DAYS=7
