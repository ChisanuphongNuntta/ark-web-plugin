{
  "General": {
    "CDC-Command": "/cdc",  \\ used to change the colour of a dino using its name, duplicate names will result in random selection
    "SDC-Command": "/sdc",  \\ used to change the colour of a dino while looking at it
    "RequireAdmin": false,  \\ Needs admin permission to use, true = yes
    "NeuterAfterUse": false,  \\ Will Neuter/Spay a dino after colouring 
    "Permission": {
      "Enable": true,   \\ if true will check first if user has permission below 
      "Name": "DinoColourCommand" \\ permission that will be checked for when using colour commands
    },
    "TokenBank": {
      "Enable": true, \\ If true will use tokens to colour dino
      "Cost": 3,
      "Type": "DinoColor" \\ Token group name for colouring dino
    },
    "ArkShop": {
      "Enable": true, \\ if true will use ark shop points when colouring dinos
      "Cost": 3
    }\\ colouring works in this order - Permission enabled = true, TokenBank enable = true, Arkshop enable = true, if user has perm but no tokens it will use points. 
  },
