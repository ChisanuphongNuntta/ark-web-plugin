# ===========================================
# HeartShop Environment Configuration
# Copy this file to .env and fill in your values
# ===========================================

# Database
POSTGRES_USER=heartshop
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=heartshop
DATABASE_URL=postgresql://heartshop:your_secure_password_here@localhost:5433/heartshop
REDIS_URL=redis://localhost:6379

# Server
PORT=3001
NODE_ENV=development

# JWT Secret (generate with: openssl rand -base64 64)
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d

# Discord OAuth
# Get from: https://discord.com/developers/applications
DISCORD_CLIENT_ID=your_discord_client_id
DISCORD_CLIENT_SECRET=your_discord_client_secret
DISCORD_CALLBACK_URL=http://localhost:3001/api/auth/discord/callback

# Steam OAuth
# Get from: https://steamcommunity.com/dev/apikey
STEAM_API_KEY=your_steam_api_key
STEAM_REALM=http://localhost:3001
STEAM_RETURN_URL=http://localhost:3001/api/auth/steam/callback

# Frontend
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# Plugin Authentication (generate with: openssl rand -base64 32)
PLUGIN_MASTER_KEY=your_plugin_master_key_here
